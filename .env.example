# ══════════════════════════════════════════════
# Je Le Veux — Variables d'environnement
# ══════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS COMMITTER le fichier .env
#
# Niveaux de sensibilité :
#   🟢 Public   — peut être exposé côté client (clé anon)
#   🟡 Prudent  — pas critique mais mieux en env var
#   🔴 Secret   — NE JAMAIS exposer (service_role, secrets)
# ══════════════════════════════════════════════

# Supabase 🟢 (clé anon = publique, protégée par RLS)
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...votre-cle-anon

# Supabase 🔴 (NE JAMAIS mettre côté client — Edge Functions uniquement)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...ne-pas-committer

# Sentry 🟡 (Sprint 6)
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog Analytics 🟡 (Sprint 6)
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxx

# EAS Build
# EAS_PROJECT_ID=votre-project-id
